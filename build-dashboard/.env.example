# Copy to .env.local. These settings stay on the dashboard's server: none reaches the browser.

# The loader's builds dir (the same variable the loader writes with). Default: ../loader/builds
# PANGO_BUILDS_DIR=../loader/builds

# Elasticsearch clusters the Environments page checks, as name=url pairs. A build's own live check
# always asks the cluster the build wrote to (its recorded es_url). Default: local=http://localhost:9200
# LIVE_ES_TARGETS=local=http://localhost:9200

# GraphQL APIs to check, as name=url pairs. Only read-only count queries are sent.
# Default: production=https://functionome.geneontology.org/api/graphql
# LIVE_API_TARGETS=production=https://functionome.geneontology.org/api/graphql,local=http://localhost:5000/graphql

# The API versions (dataset names) to ask the APIs about. Default: pango-1,pango-2
# LIVE_API_VERSIONS=pango-1,pango-2

# Ask this cluster in a build's live check instead of the es_url the build recorded, for when the
# dashboard reaches that cluster at another address. Unset: the recorded es_url.
# LIVE_BUILD_ES_URL=http://localhost:9200
